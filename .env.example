# Trace — Vercel / hosted deployment environment variables
# Copy these into your Vercel project (Settings → Environment Variables).
# NEVER commit real secrets.

# ── Required (API) ───────────────────────────────────────────────────────────
NODE_ENV=production
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/trace
JWT_SECRET=generate-with-openssl-rand-hex-32

# Comma-separated browser origins allowed by CORS (your production domain).
# Vercel preview URLs (VERCEL_URL) are added automatically when deployed on Vercel.
ALLOWED_ORIGINS=https://trace.ahmdmshazly.me

# ── Optional (API) ───────────────────────────────────────────────────────────
JWT_EXPIRES_IN=24h
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10
APP_ORIGIN=https://trace.ahmdmshazly.me

# Mail: use smtp in production so password-reset links are delivered.
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Trace <noreply@example.com>

# ── Frontend (build-time) ────────────────────────────────────────────────────
# Leave unset when the client and API share the same origin (recommended on Vercel).
# VITE_API_BASE=/api
