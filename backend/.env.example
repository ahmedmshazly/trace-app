# Trace backend — configuration contract (see docs/04-engineering/environments.md)
# Copy to `.env` for local development. NEVER commit a real .env.
# The app validates these at startup and fails fast on missing/invalid values.

# Standard Node environment: development | test | production
NODE_ENV=development

# API listen port
PORT=4000

# MongoDB connection string (a secret in hosted environments)
MONGODB_URI=mongodb://localhost:27017/trace_dev

# JWT signing key — SECRET. Use a long random value; rotating it invalidates tokens.
JWT_SECRET=dev-only-change-me-to-a-long-random-string

# Access-token lifetime (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=7d

# CORS allowlist for the browser client (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173

# Structured logger level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Auth rate limiting (tunable; sensible defaults applied if unset)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10
